                @* @Html.DisplayNameFor(model => model.RegisterOn) *@
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
              @*       @Html.DisplayFor(modelItem =>  *@ @(item.Clients.FirstName + " " + item.Clients.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Parts.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PartQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegisterOn)
            </td>
