@model IEnumerable<ASP_Avto_Stil.Data.Order>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
               Клиент
                @* @Html.DisplayNameFor(model => model.Clients) *@
            </th>
            <th>
                Част
                @* @Html.DisplayNameFor(model => model.Parts) *@
            </th>
            <th>
                Количество
