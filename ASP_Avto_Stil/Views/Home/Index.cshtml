@{
    ViewData["Title"] = "Начало";
}

<section class="home-hero mb-5">
    <img src="/images/bmw-m-aesthetic.webp" alt="BMW M3 G80 на пейзажен фон" />
    <div class="home-hero__content">
        <h1>АвтоСтил</h1>
        <p>Тунинг решения, аксесоари и подбрани части за автомобили с характер.</p>
        <div class="d-flex flex-wrap gap-3">
            <a asp-controller="Home" asp-action="Tuning" class="btn btn-warning btn-lg px-4 fw-bold text-dark">Тунинг решения</a>
            <a asp-controller="Home" asp-action="Gallery" class="btn btn-outline-light btn-lg px-4">Галерия</a>
        </div>
    </div>
</section>

<section class="section-band mb-5">
    <div class="section-heading">
        <span>Публични секции</span>
        <h2>Всичко важно е достъпно от началната страница</h2>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Tuning" class="feature-tile">
                <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_M3_Competition_Touring_G81_%2853988362250%29.jpg" alt="BMW M3 Competition Touring" />
                <strong>Тунинг решения</strong>
                <span>Визия, звук, окачване и спортно усещане.</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="AccessoriesCatalog" class="feature-tile">
                <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_M3_Competition_xDrive_Touring_%28G81%2C_2024%29_%2854540429240%29.jpg" alt="BMW M3 Competition xDrive Touring" />
                <strong>Каталог за аксесоари</strong>
                <span>Интериор, екстериор и практични добавки.</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Gallery" class="feature-tile">
                <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_G82_%28M4%29_%2852591194280%29.jpg" alt="BMW M4 G82" />
                <strong>Галерия</strong>
                <span>Подбрани BMW M автомобили за вдъхновение.</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Home" asp-action="Contacts" class="feature-tile">
                <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_M3_Touring_%28G81%2C_2022%29_%2852569510933%29.jpg" alt="BMW M3 Touring G81" />
                <strong>Контакти</strong>
                <span>Свържете се за оферта или консултация.</span>
            </a>
        </div>
    </div>
</section>

<section class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="info-card h-100">
            <h3>Безкомпромисно качество</h3>
            <p>Работим с доказани производители и подбираме части, които стоят добре и издържат на реално каране.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card h-100">
            <h3>Бърза доставка</h3>
            <p>Поръчките се обработват експресно, а наличните артикули могат да стигнат до всяка точка на страната.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card h-100">
            <h3>Консултация</h3>
            <p>Помагаме при избора на аксесоари и тунинг решения според модела, бюджета и търсения стил.</p>
        </div>
    </div>
</section>
