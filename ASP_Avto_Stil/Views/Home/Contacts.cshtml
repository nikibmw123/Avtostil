@{
    ViewData["Title"] = "Контакти";
}

<section class="page-hero compact">
    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_M3_Touring_%28G81%2C_2022%29_%2852569510933%29.jpg" alt="BMW M3 Touring контакти" />
    <div>
        <span>АвтоСтил</span>
        <h1>Контакти</h1>
        <p>Свържете се с нас за консултация, оферта или помощ при избор на тунинг решение и аксесоари.</p>
    </div>
</section>

<section class="contact-grid mt-4">
    <div class="contact-info">
        <h2>Информация</h2>
        <div class="contact-item">
            <div class="contact-icon">📍</div>
            <div>
                <h3>Адрес</h3>
                <p>гр. София, България</p>
            </div>
        </div>
        <div class="contact-item">
            <div class="contact-icon">☎</div>
            <div>
                <h3>Телефон</h3>
                <p>+359 888 123 456</p>
            </div>
        </div>
        <div class="contact-item">
            <div class="contact-icon">✉</div>
            <div>
                <h3>Имейл</h3>
                <p>info@avtostil.bg</p>
            </div>
        </div>
    </div>

    <div class="contact-form-container">
        <h2>Запитване</h2>
        <form class="contact-form">
            <input type="text" placeholder="Вашето име" />
            <input type="email" placeholder="Имейл" />
            <textarea rows="5" placeholder="Какво търсите?"></textarea>
            <button type="button">Изпрати</button>
        </form>
    </div>
</section>
