@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card bg-dark border-secondary shadow">
            <div class="card-header bg-dark text-warning border-bottom border-secondary text-center py-3">
                <h3 class="mb-0">Създаване на профил</h3>
            </div>
            <div class="card-body p-4 text-light">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    
                    <div class="form-floating mb-3 text-dark">
                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="username" />
                        <label asp-for="Input.UserName">Потребителско име</label>
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3 text-dark">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Имейл</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="row g-2 mb-3 text-dark">
                        <div class="col-md-6 form-floating">
                            <input asp-for="Input.FirstName" class="form-control" aria-required="true" placeholder="Име" />
                            <label asp-for="Input.FirstName" class="ps-3">Име</label>
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="Input.LastName" class="form-control" aria-required="true" placeholder="Фамилия" />
                            <label asp-for="Input.LastName" class="ps-3">Фамилия</label>
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-floating mb-3 text-dark">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password">Парола</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-4 text-dark">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Потвърди парола</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <button id="registerSubmit" type="submit" class="btn btn-warning w-100 fw-bold">Регистрирай се</button>
                    
                    <div class="mt-4 text-center">
                        <p>
                            <a class="text-warning text-decoration-none" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Вече имате профил? Вход тук.</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
