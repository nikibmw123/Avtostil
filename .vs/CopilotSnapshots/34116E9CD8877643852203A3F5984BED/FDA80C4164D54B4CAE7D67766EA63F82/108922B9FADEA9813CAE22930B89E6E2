@model ASP_Avto_Stil.Data.Order

@{
    ViewData["Title"] = "Добавяне на поръчка";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card bg-dark border-secondary shadow">
            <div class="card-header bg-dark text-warning border-bottom border-secondary py-3">
                <h3 class="mb-0">Създаване на поръчка</h3>
            </div>
            <div class="card-body p-4 text-light">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-4">
                        <label asp-for="PartsId" class="form-label control-label">Част</label>
                        <select asp-for="PartsId" class="form-control bg-dark text-light border-secondary" asp-items="ViewBag.PartsId"></select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PartQuantity" class="form-label control-label">Количество</label>
                        <input asp-for="PartQuantity" class="form-control bg-dark text-light border-secondary" type="number" />
                        <span asp-validation-for="PartQuantity" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-bold px-4">Създай</button>
                        <a asp-action="Index" class="btn btn-outline-light px-4">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
