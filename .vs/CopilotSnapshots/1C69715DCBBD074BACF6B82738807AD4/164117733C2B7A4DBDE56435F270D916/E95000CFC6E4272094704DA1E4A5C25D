@model ASP_Avto_Stil.Data.Part

@{
    ViewData["Title"] = "Добавяне на част";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card bg-dark border-secondary shadow">
            <div class="card-header bg-dark text-warning border-bottom border-secondary py-3">
                <h3 class="mb-0">Завеждане на нова авточаст</h3>
            </div>
            <div class="card-body p-4 text-light">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label control-label">Име на частта</label>
                            <input asp-for="Name" class="form-control bg-dark text-light border-secondary" placeholder="Напр. Спирачни дискове" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategorieId" class="form-label control-label">Категория</label>
                            <select asp-for="CategorieId" class ="form-select bg-dark text-light border-secondary" asp-items="ViewBag.CategorieId"></select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label control-label">Описание</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Кратко описание на артикула..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BrandModelId" class="form-label control-label">За модел</label>
                            <select asp-for="BrandModelId" class ="form-select bg-dark text-light border-secondary" asp-items="ViewBag.BrandModelId"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ImageURL" class="form-label control-label">Снимка (URL)</label>
                            <input asp-for="ImageURL" class="form-control bg-dark text-light border-secondary" placeholder="https://..." />
                            <span asp-validation-for="ImageURL" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Price" class="form-label control-label">Цена в лв.</label>
                            <input asp-for="Price" class="form-control bg-dark text-light border-secondary" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="Quantity" class="form-label control-label">Количество (Наличност)</label>
                            <input asp-for="Quantity" class="form-control bg-dark text-light border-secondary" type="number" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-bold px-4">Създай</button>
                        <a asp-action="Index" class="btn btn-outline-light px-4">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
