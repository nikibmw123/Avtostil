@model IEnumerable<ASP_Avto_Stil.Data.Order>

@{
    ViewData["Title"] = "Поръчки";
}

<h1 class="text-warning mb-4">Всички поръчки</h1>

<p class="mb-4">
    <a asp-action="Create" class="btn btn-warning fw-bold text-dark">Регистрирай нова поръчка</a>
</p>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover border-secondary">
        <thead>
            <tr>
                <th>Клиент</th>
                <th>Част</th>
                <th>Количество</th>
                <th>Дата на поръчка</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="align-middle">
                        @(item.Clients.FirstName + " " + item.Clients.LastName)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.Parts.Name)
                    </td>
                    <td class="align-middle">
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.PartQuantity) бр.</span>
                    </td>
                    <td class="align-middle">
                        @item.RegisterOn.ToString("dd.MM.yyyy HH:mm")
                    </td>
                    <td class="text-end align-middle">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Редакция</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
