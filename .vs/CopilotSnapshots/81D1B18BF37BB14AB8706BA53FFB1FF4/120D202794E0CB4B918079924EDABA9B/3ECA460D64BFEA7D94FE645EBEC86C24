@model ASP_Avto_Stil.Data.BrandModel

@{
    ViewData["Title"] = "Изтриване";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="alert alert-danger shadow border-danger" role="alert">
            <h4 class="alert-heading alert-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Внимание!</h4>
            <p>Сигурни ли сте, че искате да изтриете този модел?</p>
        </div>

        <div class="card bg-dark border-secondary shadow text-light mt-3">
            <div class="card-header bg-dark text-danger border-bottom border-secondary py-3">
                <h3 class="mb-0">Изтриване на модел</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-warning">Марка</dt>
                    <dd class="col-sm-8 mb-3">@Html.DisplayFor(model => model.Brand)</dd>
                    
                    <dt class="col-sm-4 text-warning">Модел</dt>
                    <dd class="col-sm-8 mb-0">@Html.DisplayFor(model => model.Model)</dd>
                </dl>
            </div>
            <div class="card-footer bg-dark border-top border-secondary py-3">
                <form asp-action="Delete" class="d-flex gap-2">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger fw-bold px-4">Да, изтрий</button>
                    <a asp-action="Index" class="btn btn-outline-light px-4">Отказ</a>
                </form>
            </div>
        </div>
    </div>
</div>
