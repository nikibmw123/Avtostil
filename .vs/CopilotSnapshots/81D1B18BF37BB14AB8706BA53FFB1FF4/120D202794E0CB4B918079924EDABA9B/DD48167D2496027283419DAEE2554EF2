@model ASP_Avto_Stil.Data.BrandModel

@{
    ViewData["Title"] = "Добавяне на модел";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card bg-dark border-secondary shadow">
            <div class="card-header bg-dark text-warning border-bottom border-secondary py-3">
                <h3 class="mb-0">Добавяне на нов модел автомобил</h3>
            </div>
            <div class="card-body p-4 text-light">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Brand" class="form-label control-label">Марка</label>
                        <input asp-for="Brand" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model" class="form-label control-label">Модел</label>
                        <input asp-for="Model" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label control-label">Описание</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-light border-secondary" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="RegisterOn" class="form-label control-label">Регистриран на</label>
                        <input asp-for="RegisterOn" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="RegisterOn" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-bold px-4">Създай</button>
                        <a asp-action="Index" class="btn btn-outline-light px-4">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
